# Merge these entries into CMD Runner's existing environment; do not replace .env.
# Verified against legacy approval-note samples in each Forth account on 2026-10-20.
# Type 1 is General in both accounts. Their legacy visibility differs.
SETTLEMENT_APPROVAL_EMAIL_NOTE_TYPE_LDR=1
SETTLEMENT_APPROVAL_EMAIL_NOTE_PUBLIC_LDR=false
SETTLEMENT_APPROVAL_EMAIL_NOTE_TYPE_PLAW=1
SETTLEMENT_APPROVAL_EMAIL_NOTE_PUBLIC_PLAW=true

# Enable only after configuring recipients and coordinating the controlled cutover.
SETTLEMENT_APPROVAL_EMAIL_LIVE_ENABLED=false
