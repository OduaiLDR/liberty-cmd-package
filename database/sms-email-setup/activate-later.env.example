# Prepared for Monther's confirmed LT distribution. Merge reviewed keys only;
# never replace a host's complete .env with this file.
# Keep disabled until the outbox migration and gateway fix are deployed, the
# recipient row is verified, and approved recipient-accessible links exist.
CMD_SMS_EMAIL_HANDOFF_ENABLED=false
CMD_SMS_EMAIL_REPORT_SOURCE=plaw
CMD_SMS_EMAIL_REPORT_NAME="SMS Export"
CMD_SMS_EMAIL_REPORT_COMPANY=LT

# Exact DNS hostnames, comma separated, only after reviewing a real link.
# Empty intentionally. Do not use *, a URL, an invented host or example.com.
CMD_SMS_EMAIL_ALLOWED_LINK_HOSTS=

# Reuse the host's existing GRAPH_LT_* credentials; no credentials belong here.
# Configuration presence is not proof of mailbox send permission or delivery.
# Later: install only the reviewed SMS email-outbox migration using the normal
# runner migration repository; do not rerun core migrations. Verify the installed
# package/runner pin and this distribution before enabling the email flag.
# Prepare only an approved run with verified final-file link receipts. Queue
# only its reviewed payload SHA-256 with --confirm-send. No historical sweep,
# automatic send on approval, or retry of an uncertain provider attempt.
